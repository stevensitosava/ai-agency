# Copy this file to .env and fill in real values. .env is gitignored.

# Google AI Studio (Gemini) — get at https://aistudio.google.com/apikey
# Create the key INSIDE the project that has your $300 credits (gen-lang-client-0359845969)
GOOGLE_AI_STUDIO_KEY=AIzaSy...

# Tavily web search — get at https://tavily.com (free tier: 1,000 searches/mo)
TAVILY_API_KEY=tvly-...

# Vertex AI key (AQ.-format) — used by the eval suite to bypass AI Studio
# free-tier daily caps. Get one from https://aistudio.google.com/apikey while
# signed in to the project that holds your billing/credits.
VERTEX_API_KEY=AQ...
VERTEX_PROJECT=gen-lang-client-XXXXXXX

# Optional later (Week 6)
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=ai-agency
